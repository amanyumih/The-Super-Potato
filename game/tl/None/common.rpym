## Textos do próprio Ren'Py em português.
##
## O Ren'Py carrega este arquivo sozinho ao abrir o jogo (tl/None/common.rpym)
## e usa as traduções abaixo no idioma padrão. Aqui ficam só os textos que o
## jogador vê: confirmações, avisos, datas dos saves. Os textos dos menus e
## botões ficam em screens.rpy.
##
## Regra: a linha "old" tem de ser idêntica ao texto original em inglês.

translate None strings:

    ## Dias da semana e meses (datas dos saves)
    old "{#weekday}Monday"
    new "{#weekday}segunda-feira"

    old "{#weekday}Tuesday"
    new "{#weekday}terça-feira"

    old "{#weekday}Wednesday"
    new "{#weekday}quarta-feira"

    old "{#weekday}Thursday"
    new "{#weekday}quinta-feira"

    old "{#weekday}Friday"
    new "{#weekday}sexta-feira"

    old "{#weekday}Saturday"
    new "{#weekday}sábado"

    old "{#weekday}Sunday"
    new "{#weekday}domingo"

    old "{#weekday_short}Mon"
    new "{#weekday_short}seg"

    old "{#weekday_short}Tue"
    new "{#weekday_short}ter"

    old "{#weekday_short}Wed"
    new "{#weekday_short}qua"

    old "{#weekday_short}Thu"
    new "{#weekday_short}qui"

    old "{#weekday_short}Fri"
    new "{#weekday_short}sex"

    old "{#weekday_short}Sat"
    new "{#weekday_short}sáb"

    old "{#weekday_short}Sun"
    new "{#weekday_short}dom"

    old "{#month}January"
    new "{#month}janeiro"

    old "{#month}February"
    new "{#month}fevereiro"

    old "{#month}March"
    new "{#month}março"

    old "{#month}April"
    new "{#month}abril"

    old "{#month}May"
    new "{#month}maio"

    old "{#month}June"
    new "{#month}junho"

    old "{#month}July"
    new "{#month}julho"

    old "{#month}August"
    new "{#month}agosto"

    old "{#month}September"
    new "{#month}setembro"

    old "{#month}October"
    new "{#month}outubro"

    old "{#month}November"
    new "{#month}novembro"

    old "{#month}December"
    new "{#month}dezembro"

    old "{#month_short}Jan"
    new "{#month_short}jan"

    old "{#month_short}Feb"
    new "{#month_short}fev"

    old "{#month_short}Mar"
    new "{#month_short}mar"

    old "{#month_short}Apr"
    new "{#month_short}abr"

    old "{#month_short}May"
    new "{#month_short}mai"

    old "{#month_short}Jun"
    new "{#month_short}jun"

    old "{#month_short}Jul"
    new "{#month_short}jul"

    old "{#month_short}Aug"
    new "{#month_short}ago"

    old "{#month_short}Sep"
    new "{#month_short}set"

    old "{#month_short}Oct"
    new "{#month_short}out"

    old "{#month_short}Nov"
    new "{#month_short}nov"

    old "{#month_short}Dec"
    new "{#month_short}dez"

    old "%b %d, %H:%M"
    new "%d/%m, %H:%M"

    ## Salvar e carregar
    old "Quick save complete."
    new "Salvamento rápido concluído."

    ## Confirmações
    old "Are you sure?"
    new "Tem certeza?"

    old "Are you sure you want to delete this save?"
    new "Tem certeza de que quer apagar este salvamento?"

    old "Are you sure you want to overwrite your save?"
    new "Tem certeza de que quer salvar por cima deste salvamento?"

    old "Loading will lose unsaved progress.\nAre you sure you want to do this?"
    new "Carregar faz perder o progresso não salvo.\nTem certeza de que quer continuar?"

    old "Are you sure you want to quit?"
    new "Tem certeza de que quer sair?"

    old "Are you sure you want to return to the main menu?\nThis will lose unsaved progress."
    new "Tem certeza de que quer voltar ao menu principal?\nO progresso não salvo será perdido."

    old "Are you sure you want to end the replay?"
    new "Tem certeza de que quer encerrar o replay?"

    old "Are you sure you want to begin skipping?"
    new "Tem certeza de que quer começar a pular?"

    old "Are you sure you want to skip to the next choice?"
    new "Tem certeza de que quer pular até a próxima escolha?"

    old "Are you sure you want to skip unseen dialogue to the next choice?"
    new "Tem certeza de que quer pular os diálogos não lidos até a próxima escolha?"

    ## Avisos
    old "Failed to save screenshot as %s."
    new "Não foi possível salvar a captura de tela como %s."

    old "Saved screenshot as %s."
    new "Captura de tela salva como %s."

    old "Skip Mode"
    new "Modo pular"

    old "This program contains free software under a number of licenses, including the MIT License and GNU Lesser General Public License. A complete list of software, including links to full source code, can be found {a=https://www.renpy.org/l/license}here{/a}."
    new "Este programa contém software livre sob várias licenças, entre elas a Licença MIT e a GNU Lesser General Public License. A lista completa dos softwares, com links para o código-fonte, está {a=https://www.renpy.org/l/license}aqui{/a}."

    ## Leitura em voz alta (acessibilidade)
    old "Self-voicing disabled."
    new "Leitura em voz alta desativada."

    old "Self-voicing enabled. "
    new "Leitura em voz alta ativada. "

    old "Clipboard voicing enabled. "
    new "Leitura pela área de transferência ativada. "

    ## Aviso de desempenho gráfico (aparece em computadores antigos)
    old "Performance Warning"
    new "Aviso de desempenho"

    old "This computer is using software rendering."
    new "Este computador está desenhando os gráficos por software."

    old "This game requires use of GL2 that can't be initialised."
    new "Este jogo precisa do GL2, que não pôde ser iniciado."

    old "This computer has a problem displaying graphics: [problem]."
    new "Este computador tem um problema para exibir gráficos: [problem]."

    old "Its graphics drivers may be out of date or not operating correctly. This can lead to slow or incorrect graphics display."
    new "Os drivers de vídeo podem estar desatualizados ou com defeito. Isso pode deixar os gráficos lentos ou errados."

    old "Continue, Show this warning again"
    new "Continuar e mostrar este aviso de novo"

    old "Continue, Don't show warning again"
    new "Continuar e não mostrar mais este aviso"

    old "Changes will take effect the next time this program is run."
    new "As mudanças valem a partir da próxima vez que o jogo for aberto."

    old "Quit"
    new "Sair"

    ## Controle (gamepad)
    old "Select Gamepad to Calibrate"
    new "Escolha o controle para calibrar"

    old "No Gamepads Available"
    new "Nenhum controle disponível"

    old "Calibrating [name] ([i]/[total])"
    new "Calibrando [name] ([i]/[total])"

    old "Press or move the '[control!s]' [kind]."
    new "Aperte ou mova: '[control!s]' [kind]."

    old "Skip (A)"
    new "Pular (A)"

    old "Back (B)"
    new "Voltar (B)"
